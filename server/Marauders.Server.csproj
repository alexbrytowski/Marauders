<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Content Remove="data/**/*" />
    <Content Remove="characters.local.json" />
    <Content Update="wwwroot/characters/**/*" CopyToPublishDirectory="PreserveNewest" />
    <Content Update="board.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Update="maps/*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="Exists('../client/dist/index.html')">
    <Content Include="../client/dist/**/*" Link="wwwroot/%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="ValidateReleaseAssets" BeforeTargets="PrepareForPublish" Condition="'$(RequireReleaseAssets)' == 'true'">
    <ItemGroup>
      <RequiredPortrait Include="alex-the-merciless;alyssa-the-witch;dylan-the-salty-dog;hayven-the-merchant;jacob-the-vengeful;jared-the-oil-baron;josh-the-phantom;steven-the-cruel" />
    </ItemGroup>
    <Error Condition="!Exists('../client/dist/index.html')" Text="Build the client with npm ci and npm run build before publishing a release." />
    <Error Condition="!Exists('wwwroot/characters/%(RequiredPortrait.Identity).jpg')" Text="Required release portrait is missing: %(RequiredPortrait.Identity).jpg" />
  </Target>

</Project>
