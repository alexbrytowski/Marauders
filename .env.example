# ASP.NET Core settings. Load these in your shell or hosting environment.
# Do not put secrets or a production hostname in this file.
ASPNETCORE_ENVIRONMENT=Development
Game__TurnSeconds=135
Game__ActionSeconds=45
# Game__DataDirectory=<absolute writable data directory>
# Set Game__ResetPassword in the server process environment (12+ characters).
# Supply the value locally; never add a real password to this example.
# Production only: set this to true when the app is reached exclusively through
# its hosting provider's HTTPS reverse proxy (for example, Railway).
# Game__TrustForwardedHeaders=true

# Optional Vite proxy override (development/E2E only).
# MARAUDERS_API_URL=http://localhost:5133
