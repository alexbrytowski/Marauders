# Build-context allowlist: no local saves, keys, secrets, original photos or tools.
**
!Dockerfile
!.dockerignore
!global.json
!NuGet.Config
!deploy/
!deploy/entrypoint.sh
!client/
!client/package.json
!client/package-lock.json
!client/index.html
!client/tsconfig*.json
!client/vite.config.ts
!client/src/
!client/src/**
!client/public/
!client/public/**
!server/
!server/*.cs
!server/Marauders.Server.csproj
!server/appsettings.json
!server/board.json
!server/Controllers/
!server/Controllers/*.cs
!server/maps/
!server/maps/*.json
!server/wwwroot/
!server/wwwroot/characters/
!server/wwwroot/characters/*.jpg
